# ==============================================================================
# CaDesk Production Environment Configuration Template
# Copy this file to .env on your production host: cp .env.production.example .env
# Protect this file: chmod 600 .env (NEVER COMMIT TO GIT)
# ==============================================================================

# Domain & SSL (Let's Encrypt automatic certificate provisioning)
SITE_ADDRESS=app.cadesk.in
LETSENCRYPT_EMAIL=security@cadesk.in

# PostgreSQL Passwords
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_STRONG_PASSWORD_32_CHARS
APP_DB_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD_32_CHARS
OWNER_DB_PASSWORD=CHANGE_ME_OWNER_ROLE_PASSWORD_32_CHARS

# JWT Token Signing Key (Minimum 32 characters, cryptographically random)
JWT_SIGNING_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64_CHARACTERS

# Automated Backup Encryption Key (Used for OpenSSL AES-256-CBC)
BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_BACKUP_ENCRYPTION_KEY_32_CHARS

# Cloud Storage Backup Destination (Optional - works with AWS S3, Cloudflare R2, MinIO, Wasabi)
BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_DEFAULT_REGION=ap-south-1
# BACKUP_GCS_BUCKET=cadesk-production-backups
# HEALTHCHECK_BACKUP_URL=https://hc-ping.com/your-uuid-here

# Document Vault Storage ("Local" uses mounted volume /documents; "S3" uses S3/R2/MinIO bucket)
DOCUMENTS_STORAGE=Local
DOCUMENTS_STORAGE_PATH=/documents
DOCUMENTS_SCAN_MODE=ClamAv
# Required only when DOCUMENTS_STORAGE=S3:
# DOCUMENTS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# DOCUMENTS_S3_REGION=ap-south-1
# DOCUMENTS_S3_BUCKET=cadesk-prod-documents
# DOCUMENTS_S3_ACCESS_KEY=CHANGE_ME
# DOCUMENTS_S3_SECRET_KEY=CHANGE_ME
# DOCUMENTS_S3_PREFIX=documents

# Production Email (Smtp | SendGrid | Ses | Log)
EMAIL_MODE=Smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.YOUR_SENDGRID_PRODUCTION_KEY
EMAIL_FROM=notifications@cadesk.in
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# SES_REGION=ap-south-1

# WhatsApp Business Cloud API ("Log" or "Cloud" - per-firm tokens configured in CaDesk UI)
WHATSAPP_MODE=Log
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_GENERATE_RANDOM_WHATSAPP_VERIFY_TOKEN

# Rate Limits (keep strict in production; raise temporarily only for load testing)
RATE_LIMIT_AUTH_PER_MINUTE=20

# Note on Razorpay (Sprint 69):
# Each CA firm saves its own KeyId, KeySecret & WebhookSecret under CaDesk UI -> Settings -> Payments.
# Razorpay Webhook URL: https://<SITE_ADDRESS>/api/webhooks/razorpay/{firmId} (subscribe payment_link.*).
