# ==============================================================================
# CaDesk Production Environment Configuration Template
# Copy this file to .env on your production host: cp .env.production.example .env
# Protect this file: chmod 600 .env (NEVER COMMIT TO GIT)
# ==============================================================================

# Domain & SSL (Let's Encrypt automatic certificate provisioning)
SITE_ADDRESS=app.cadesk.in
LETSENCRYPT_EMAIL=security@cadesk.in

# PostgreSQL Passwords
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_STRONG_PASSWORD_32_CHARS
APP_DB_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD_32_CHARS
OWNER_DB_PASSWORD=CHANGE_ME_OWNER_ROLE_PASSWORD_32_CHARS

# JWT Token Signing Key (Minimum 32 characters, cryptographically random)
JWT_SIGNING_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64_CHARACTERS

# Automated Backup Encryption Key (Used for OpenSSL AES-256-CBC)
BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_BACKUP_ENCRYPTION_KEY_32_CHARS

# Cloud Storage Backup Destination (Optional - for off-site disaster recovery)
BACKUP_S3_BUCKET=cadesk-production-backups
# BACKUP_GCS_BUCKET=cadesk-production-backups
# HEALTHCHECK_BACKUP_URL=https://hc-ping.com/your-uuid-here

# Production Email (SMTP)
EMAIL_MODE=Smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.YOUR_SENDGRID_PRODUCTION_KEY
EMAIL_FROM=notifications@cadesk.in

# WhatsApp Business Cloud API (Optional)
WHATSAPP_MODE=Log
# WHATSAPP_ACCESS_TOKEN=EAAB...
